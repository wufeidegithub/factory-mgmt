# ============================================================
#  环境变量示例
#  复制为 .env 后按实际环境修改：cp .env.example .env
#  .env 已被 .gitignore 排除，不会入库
# ============================================================

# ---------- 安全 ----------
# 生产必须换成随机长字符串，可以用下面命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- 数据库 ----------
# 留空或 sqlite 使用 SQLite；改成 postgres 启用 PostgreSQL
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=factory_mgmt
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
