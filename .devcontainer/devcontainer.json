{
  "name": "factory-mgmt (Django 5)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": {
    "cpus": 2
  },
  "containerEnv": {
    "DJANGO_ALLOWED_HOSTS": "*",
    "DJANGO_CSRF_TRUSTED_ORIGINS": "https://*.app.github.dev",
    "PYTHONUNBUFFERED": "1"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Django runserver",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && ([ -f .env ] || cp .env.example .env) && python manage.py makemigrations --noinput && python manage.py migrate --noinput && echo '初始化完成。下一步: python manage.py createsuperuser 然后 python manage.py runserver 0.0.0.0:8000'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "batisteo.vscode-django",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "files.exclude": {
          "**/__pycache__": true,
          "**/*.pyc": true
        },
        "editor.rulers": [100]
      }
    }
  }
}
